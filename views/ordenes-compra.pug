//- views/ordenes-compra.pug
extends layout

block content
    .page-header
        h1  Órdenes de Compra
        // Solo admin puede crear
        if usuario.rol === "administrador"
            button.btn-success(onclick="abrirModalOrdenCompra()")  Nueva Orden de Compra
    
    .table-container
        table.tabla
            thead
                tr
                    th Nro Orden
                    th Fecha Emisión
                    th Situación
                    th Total
                    th Laboratorio
                    th Factura Proveedor
                    // Solo admin ve acciones
                    if usuario.rol === "administrador"
                        th Acciones
            tbody
                each ord in ordenes
                    tr
                        td= ord.NroOrdenC
                        td= new Date(ord.fechaEmision).toLocaleDateString('es-PE')
                        td
                            span.badge(class=ord.Situacion === 'aprobada' ? 'badge-usuario' : 'badge-moderador')= ord.Situacion
                        td S/. #{ord.Total.toFixed(2)}
                        td= ord.laboratorio ? ord.laboratorio.razonSocial : 'Sin laboratorio'
                        td= ord.NrofacturaProv || '-'
                        if usuario.rol === "administrador"
                            td
                                button.btn-edit(onclick=`editarOrdenCompra(${ord.NroOrdenC}, '${ord.Situacion}', ${ord.CodLab || ''}, '${ord.NrofacturaProv || ''}', ${ord.Total})`) ✏️ Editar
                                button.btn-delete(onclick=`eliminarOrdenCompra(${ord.NroOrdenC})`)  Eliminar

    if usuario.rol === "administrador"
        #modalOrdenCompra.modal-overlay
            .modal(style="max-width: 700px;")
                .modal-header
                    h2#modalOrdenCompraTitle Nueva Orden de Compra
                    button.modal-close(onclick="cerrarModalOrdenCompra()") ×
                form#formOrdenCompra
                    input#ordenCompraId(type="hidden")
                    .form-row(style="display: flex; gap: 15px;")
                        .form-group(style="flex: 1;")
                            label Fecha de Emisión
                            input#ordenCompraFecha(type="date" required)
                        .form-group(style="flex: 1;")
                            label Situación
                            select#ordenCompraSituacion(required)
                                option(value="pendiente") Pendiente
                                option(value="aprobada") Aprobada
                                option(value="cancelada") Cancelada
                    .form-row(style="display: flex; gap: 15px;")
                        .form-group(style="flex: 1;")
                            label Laboratorio
                            select#ordenCompraLab(required)
                                option(value="") Seleccionar laboratorio...
                                each lab in laboratorios
                                    option(value=lab.CodLab)= lab.razonSocial
                        .form-group(style="flex: 1;")
                            label Nro Factura Proveedor
                            input#ordenCompraFactura(type="text" placeholder="F001-000123")
                    .form-group
                        label Total (S/.)
                        input#ordenCompraTotal(type="number" step="0.01" min="0" placeholder="0.00" required)
                    .form-actions
                        button.btn-primary(type="submit")  Guardar Orden
                        button.btn-secondary(type="button" onclick="cerrarModalOrdenCompra()") Cancelar

block scripts
    if usuario.rol === "administrador"
        script.
            const token = document.cookie.split('token=')[1];
            const headers = { Authorization: `Bearer ${token}` };
            const laboratoriosData = !{JSON.stringify(laboratorios || [])};
            
            window.abrirModalOrdenCompra = function() {
                document.getElementById('modalOrdenCompraTitle').textContent = 'Nueva Orden de Compra';
                document.getElementById('formOrdenCompra').reset();
                document.getElementById('ordenCompraId').value = '';
                const selectLab = document.getElementById('ordenCompraLab');
                selectLab.innerHTML = '<option value="">Seleccionar laboratorio...</option>';
                laboratoriosData.forEach(lab => {
                    const option = document.createElement('option');
                    option.value = lab.CodLab;
                    option.textContent = lab.razonSocial;
                    selectLab.appendChild(option);
                });
                document.getElementById('ordenCompraFecha').value = new Date().toISOString().split('T')[0];
                document.getElementById('modalOrdenCompra').classList.add('active');
            }
            
            window.editarOrdenCompra = function(id, situacion, codLab, factura, total) {
                document.getElementById('modalOrdenCompraTitle').textContent = 'Editar Orden de Compra';
                document.getElementById('ordenCompraId').value = id;
                document.getElementById('ordenCompraSituacion').value = situacion;
                document.getElementById('ordenCompraLab').value = codLab;
                document.getElementById('ordenCompraFactura').value = factura;
                document.getElementById('ordenCompraTotal').value = total;
                document.getElementById('modalOrdenCompra').classList.add('active');
            }
            
            window.cerrarModalOrdenCompra = function() {
                document.getElementById('modalOrdenCompra').classList.remove('active');
            }
            
            window.eliminarOrdenCompra = async function(id) {
                if (!confirm('¿Eliminar esta orden de compra?')) return;
                try {
                    await axios.delete(`${window.API}/ordenes/compras/${id}`, { headers });
                    location.reload();
                } catch (err) { alert('Error: ' + err.message); }
            }
            
            document.getElementById('formOrdenCompra').addEventListener('submit', async (e) => {
                e.preventDefault();
                const id = document.getElementById('ordenCompraId').value;
                const data = {
                    fechaEmision: document.getElementById('ordenCompraFecha').value,
                    Situacion: document.getElementById('ordenCompraSituacion').value,
                    CodLab: document.getElementById('ordenCompraLab').value,
                    NrofacturaProv: document.getElementById('ordenCompraFactura').value,
                    Total: parseFloat(document.getElementById('ordenCompraTotal').value)
                };
                try {
                    if (id) await axios.put(`${window.API}/ordenes/compras/${id}`, data, { headers });
                    else await axios.post(`${window.API}/ordenes/compras`, data, { headers });
                    location.reload();
                } catch (err) { alert('Error: ' + (err.response?.data?.error || err.message)); }
            });
            
            document.getElementById('modalOrdenCompra').addEventListener('click', (e) => {
                if (e.target.classList.contains('modal-overlay')) window.cerrarModalOrdenCompra();
            });