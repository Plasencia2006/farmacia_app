//- views/dashboard.pug
extends layout

block content
    .dashboard
        h1  Bienvenido al Sistema
        p 
            strong Usuario: 
            span= usuario.nombre
            span(style="margin: 0 15px; color: #64748b") |
            if usuario.rol === 'administrador'
                span.badge.badge-admin  Administrador
            else if usuario.rol === 'moderador'
                span.badge.badge-moderador  Moderador
            else
                span.badge.badge-usuario  Usuario
        
        .cards
            .card
                h3  Categorías
                p Visualiza y gestiona las categorías de productos disponibles en la farmacia.
                a.btn-primary(href="/categorias") Ir a Categorías →
            
            if usuario.rol === "administrador" || usuario.rol === "moderador"
                .card
                    h3  Productos
                    p Administra el inventario de productos, precios y stock disponible.
                    a.btn-primary(href="/productos") Ir a Productos →
            
            if usuario.rol === "administrador"
                .card
                    h3  Panel de Administrador
                    p Tienes acceso completo a todas las funcionalidades del sistema.
                    a.btn-primary(href="#") Configuración →