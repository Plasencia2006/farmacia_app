//- views/layout.pug
doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= titulo || "Farmacia - Sistema"
    link(rel="stylesheet" href="/css/style.css")
  body
    if usuario
      nav.navbar
        .navbar-brand  FarmaciaApp
        .navbar-menu
          a(href="/dashboard")  Inicio
          a(href="/medicamentos")  Medicamentos
          
          // Admin y Moderador ven Laboratorios y Órdenes de Compra
          if usuario.rol === "administrador" || usuario.rol === "moderador"
            a(href="/laboratorios")  Laboratorios
            a(href="/ordenes-compra")  Orden Compra
          
          // Todos pueden ver Órdenes de Venta
          a(href="/ordenes-venta")  Orden Venta
          
          // Solo Admin ve el panel de administración
          if usuario.rol === "administrador"
            a(href="#" style="color: #f59e0b")  Admin
        
        .user-info
          span 
            strong= usuario.nombre
            span.badge(class=`badge-${usuario.rol}`) #{usuario.rol}
          a.btn-logout(href="/logout")  Salir
    
    main.container
      block content

    script(src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js")
    script(src="/js/auth.js")
    block scripts